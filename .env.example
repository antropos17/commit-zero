# Local persistent stores. This file is a template and is not loaded automatically.
DATABASE_DIR=runtime/database
IDENTITY_DATABASE_DIR=runtime/identity
# Use separate PostgreSQL databases for each data-owning service when deploying.
# DATABASE_URL=postgresql://workspace_user:change-me@127.0.0.1:5432/commit_zero
# IDENTITY_DATABASE_URL=postgresql://identity_user:change-me@127.0.0.1:5432/commit_zero_identity
PORT=4173
API_PORT=4174
WORKSPACE_PORT=4185
IDENTITY_PORT=4186
RANKING_PORT=4187
# Local experiment provider, started separately with npm run model:start.
LOCAL_MODEL_URL=http://127.0.0.1:8199

# Optional local OAuth. Copy to .env and start with: node --env-file=.env server/index.mjs
# Register each exact callback URL documented in docs/OAUTH.md.
OAUTH_ORIGIN=http://127.0.0.1:4173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
