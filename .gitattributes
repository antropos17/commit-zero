* text=auto eol=lf
*.cmd text eol=crlf
*.png binary
*.svg text eol=lf
# Preserve immutable migration checksums and vendored upstream bytes across platforms.
/db/migrations/*.sql -text whitespace=cr-at-eol,-blank-at-eof
/.agents/skills/** -text whitespace=-blank-at-eol,-blank-at-eof
/docs/vendor-licenses/** -text whitespace=-blank-at-eol,-blank-at-eof

/services/identity/migrations/*.sql -text whitespace=cr-at-eol,-blank-at-eof
