{
  "name": "commit-zero",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "model:setup": "pwsh -NoProfile -File scripts/setup-local-model.ps1",
    "model:start": "node scripts/start-local-model.mjs",
    "lab:verify": "node scripts/verify-lab.mjs",
    "agent": "node scripts/agent.mjs",
    "aigit": "node scripts/aigit.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 prototype/social-state.test.mjs tests/*.test.mjs",
    "check": "node scripts/verify.mjs full",
    "lint": "node scripts/verify.mjs lint",
    "format": "prettier --write server services shared scripts tests prototype/app prototype/social-state.mjs prototype/social.html prototype/social.css prototype/workspace.css prototype/theme.css prototype/typography.css vite.config.mjs eslint.config.mjs",
    "db:status": "node scripts/db-status.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:snapshot": "node scripts/store-snapshot.mjs create",
    "db:verify-snapshot": "node scripts/store-snapshot.mjs verify",
    "diagnostics": "node scripts/diagnostics.mjs",
    "test:ui": "playwright test",
    "test:dom": "node --test tests/interface.dom.mjs",
    "test:serve": "node scripts/smoke-build.mjs",
    "test:services": "node --test tests/services.test.mjs",
    "preview:qa": "node scripts/qa-preview.mjs",
    "check:fast": "node scripts/verify.mjs fast",
    "check:ui": "node scripts/verify.mjs ui",
    "check:commons": "node scripts/verify.mjs commons",
    "check:lab": "node scripts/verify.mjs lab",
    "check:identity": "node scripts/verify.mjs identity",
    "check:scenario": "node scripts/verify.mjs scenario",
    "check:services": "node scripts/verify.mjs services",
    "check:tooling": "node scripts/verify.mjs tooling",
    "doctor": "node scripts/doctor.mjs",
    "benchmark:backend": "node scripts/benchmark-backend.mjs",
    "simulate:commons": "node scripts/simulate-commons.mjs",
    "sandbox:doctor": "node scripts/sandbox-doctor.mjs",
    "map": "node scripts/project-map.mjs",
    "check:repo": "node scripts/repo-check.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  }
}
